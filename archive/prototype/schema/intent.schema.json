{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colchuck.ai/intent/schema/intent.schema.json",
  "title": "Intent model",
  "description": "Structured source of truth for an intent tree. Edges are declared ONCE by ID reference; backlinks, maps, tiers, slugs, and relative paths are all derived by the generator and never authored here.",
  "type": "object",
  "properties": {
    "product": { "$ref": "#/$defs/product" },
    "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" }, "minItems": 1 },
    "architecture": { "$ref": "#/$defs/architecture" },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "required": ["product", "jobs"],
  "additionalProperties": false,

  "$defs": {
    "localOutcomeId": { "type": "string", "pattern": "^O\\d{3,}$" },
    "localRiskId": { "type": "string", "pattern": "^RSK\\d{3,}$" },
    "localReqId": { "type": "string", "pattern": "^R\\d{3,}$" },
    "componentId": { "type": "string", "pattern": "^C\\d{3,}$" },
    "recordId": { "type": "string", "pattern": "^(PDR|ADR|CR)\\d{3,}$" },
    "qualifiedReqRef": {
      "description": "Requirement referenced from outside its outcome, e.g. O002-R001",
      "type": "string",
      "pattern": "^O\\d{3,}-R\\d{3,}$"
    },

    "product": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["name", "summary"],
      "additionalProperties": false
    },

    "job": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "story": {
          "type": "string",
          "description": "One prose sentence. Prose stays prose — the graph is what we structure, not the sentence.",
          "pattern": "^When .+ I want .+ so .+\\.$"
        },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } }
      },
      "required": ["name", "story"],
      "additionalProperties": false
    },

    "outcome": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/localOutcomeId" },
        "name": { "type": "string" },
        "statement": { "type": "string" },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      },
      "required": ["id", "name", "statement"],
      "additionalProperties": false
    },

    "risk": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/localRiskId" },
        "name": { "type": "string" },
        "statement": { "type": "string" }
      },
      "required": ["id", "name", "statement"],
      "additionalProperties": false
    },

    "requirement": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/localReqId" },
        "name": { "type": "string" },
        "statement": { "type": "string" },
        "mitigates": {
          "description": "Risk edge, declared once. Same-outcome risks by local id (RSK001). minItems:1 replaces the linter's 'requirement-without-risk' check structurally.",
          "type": "array",
          "items": { "$ref": "#/$defs/localRiskId" },
          "minItems": 1
        },
        "dependsOn": {
          "description": "Prerequisite requirements (blocking coupling), qualified across outcomes.",
          "type": "array",
          "items": { "$ref": "#/$defs/qualifiedReqRef" }
        }
      },
      "required": ["id", "name", "statement", "mitigates"],
      "additionalProperties": false
    },

    "architecture": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "principles": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "technologyChoices": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "summary"],
      "additionalProperties": false
    },

    "component": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/componentId" },
        "name": { "type": "string" },
        "responsibility": { "type": "string" },
        "fulfills": {
          "description": "Requirement edge, declared once. The Requirement-Component Map is derived from these — never authored.",
          "type": "array",
          "items": { "$ref": "#/$defs/qualifiedReqRef" },
          "minItems": 1
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "to": { "$ref": "#/$defs/componentId" },
              "note": { "type": "string" }
            },
            "required": ["to", "note"],
            "additionalProperties": false
          }
        },
        "body": {
          "description": "Optional detail. Presence of body content is what the generator uses to PROMOTE a component to its own file — tier is a render decision, not authored state.",
          "type": "object",
          "properties": {
            "dataModel": { "type": "string" },
            "interfaces": { "type": "string" },
            "behavior": { "type": "string" },
            "edgeCases": { "type": "array", "items": { "type": "string" } },
            "successCriteria": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "responsibility", "fulfills"],
      "additionalProperties": false
    },

    "record": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "kind": { "type": "string", "enum": ["pdr", "adr", "cr"] },
        "name": { "type": "string" },
        "slug": { "type": "string", "description": "Optional slug override; derived from name when omitted." },
        "affects": {
          "description": "Element edge, declared once. See Also backlinks on each element are derived from this — never authored on the element.",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "summary": { "type": "string" },
        "context": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "decision": { "type": "string" },
        "consequences": { "type": "array", "items": { "type": "string" } },
        "change": { "type": "string" },
        "rationale": { "type": "string" },
        "affectsNarrative": { "type": "string" }
      },
      "required": ["id", "kind", "name", "affects", "summary"],
      "additionalProperties": false
    }
  }
}
